#!/bin/bash
# Resizer.app launcher: starts the local server in the background and opens the browser.
# The app must stay inside the resizer folder (next to resizer.py).

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
APP="$(cd "$(dirname "$0")/../.." && pwd)"
ROOT="$(dirname "$APP")"
PORT=8765
URL="http://127.0.0.1:$PORT"
LOG="$HOME/Library/Logs/Resizer.log"
OUT="$HOME/Movies/Resizer"
WORK="$HOME/Library/Caches/Resizer"

alert() {
  osascript -e "display dialog \"$1\" with title \"Resizer\" buttons {\"OK\"} default button 1 with icon caution" >/dev/null 2>&1
}

# Already running -> just open the page.
if curl -s --max-time 1 "$URL/api/ping" | grep -q resizer; then
  open "$URL"
  exit 0
fi

if [ ! -f "$ROOT/resizer.py" ]; then
  alert "Не знайдено resizer.py. Resizer.app має лежати в папці resizer. Щоб додати в Dock — перетягніть іконку з цієї папки, не копіюйте застосунок."
  exit 1
fi

PY=""
for c in /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
  if [ -x "$c" ] && "$c" -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
    PY="$c"
    break
  fi
done
if [ -z "$PY" ]; then
  alert "Потрібен Python 3. Якщо macOS запропонувала встановити інструменти розробника — погодьтесь, дочекайтесь завершення і запустіть Resizer ще раз."
  exit 1
fi

if ! command -v ffmpeg >/dev/null 2>&1 || ! command -v ffprobe >/dev/null 2>&1; then
  if command -v brew >/dev/null 2>&1; then
    CMD='brew install ffmpeg'
  else
    CMD='/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" && eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv)" && brew install ffmpeg'
  fi
  CMD="$CMD && echo && echo 'Готово. Запустіть Resizer ще раз.'"
  ANSWER=$(osascript -e 'button returned of (display dialog "Для рендеру потрібен ffmpeg (один раз). Встановити зараз? Відкриється Термінал — після завершення запустіть Resizer ще раз." with title "Resizer" buttons {"Скасувати", "Встановити"} default button 2)' 2>/dev/null)
  if [ "$ANSWER" = "Встановити" ]; then
    ESC=${CMD//\\/\\\\}
    ESC=${ESC//\"/\\\"}
    osascript -e "tell application \"Terminal\" to do script \"$ESC\"" -e 'tell application "Terminal" to activate' >/dev/null
  fi
  exit 0
fi

mkdir -p "$(dirname "$LOG")" "$OUT"
nohup "$PY" "$ROOT/resizer.py" --port "$PORT" --out "$OUT" --work "$WORK" --idle-exit 300 \
  >"$LOG" 2>&1 </dev/null &
PID=$!
disown

sleep 2
if ! kill -0 "$PID" 2>/dev/null; then
  ERR=$(tail -n 5 "$LOG" | tr '"' "'" )
  alert "Resizer не запустився. $ERR  (Лог: ~/Library/Logs/Resizer.log)"
  exit 1
fi
exit 0
